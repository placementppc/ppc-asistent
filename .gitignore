!scripts/hlidac/ucty.example.json

# Výstupy (reporty hlídačů, forecast a krycí plány)
reports/
plans/
data/
exports/
*-raw-*.json
*.state.json
plan.json
*.preview.html
preview.html
deploy/vercel/balik/

# Bannery: vygenerované složky klientů (případná ukázka se odblokuje níž)
banner-generator/banners-*/
!banner-generator/banners-ukazka/
banner-generator/node_modules/

# ChatGPT Ads: lokální stav rozpočtu dotazů
chatgpt-ads/.usage/
chatgpt-ads/.venv/

# Python
.venv/
venv/
__pycache__/
*.py[cod]
.mypy_cache/
.pytest_cache/

# Node
node_modules/

# Claude Code: osobní nastavení
.claude/settings.local.json
