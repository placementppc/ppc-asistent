# ====== PPC asistent — přístupy k API ======
# Zkopíruj:  cp .env.example .env   a vyplň jen systémy, které používáš.
# .env NIKDY necommituj (je v .gitignore) a hodnoty nikdy neposílej do chatu.
# Claude tenhle soubor (.env) nečte — blokuje to hook env_guard. Skripty si klíče načtou samy.
# Návody: docs/napojeni/<system>.md · bezpečnost: docs/bezpecnost.md
#
# ID účtů klientů (customer ID, userId, act_…, property ID) sem NEPATŘÍ.
# Patří do clients/<klient>.md a skriptům se předávají jako argument.

# --- Google Ads (docs/napojeni/google-ads.md) ---
# OAuth klient typu "Desktop app" z Google Cloud projektu.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
# Vygeneruje: .venv/bin/python scripts/google_ads/generate_refresh_token.py --write-env
GOOGLE_ADS_REFRESH_TOKEN=
# Číslo MCC (správcovského účtu), jen číslice bez pomlček.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Developer tokeny Google zrušil 9. 9. 2026 (přístup určuje Cloud projekt). Nech prázdné.
GOOGLE_ADS_DEVELOPER_TOKEN=

# --- Google Ads: druhý MCC / druhý Cloud projekt (volitelné) ---
# Skripty ho použijí s GOOGLE_ADS_PROFILE=<nazev> před příkazem, např.
#   GOOGLE_ADS_PROFILE=druhy .venv/bin/python scripts/google_ads/fetch.py --list-clients
# a čtou pak GOOGLE_ADS_<NAZEV>_* (výchozí sada výš zůstane nedotčená). GA4 profily nezná.
# GOOGLE_ADS_DRUHY_CLIENT_ID=
# GOOGLE_ADS_DRUHY_CLIENT_SECRET=
# GOOGLE_ADS_DRUHY_REFRESH_TOKEN=
# GOOGLE_ADS_DRUHY_LOGIN_CUSTOMER_ID=

# --- GA4 (docs/napojeni/google-ads.md + docs/napojeni/ga4.md) ---
# Žádné vlastní proměnné: GA4 čte GOOGLE_ADS_CLIENT_ID / _CLIENT_SECRET / _REFRESH_TOKEN.
# Refresh token musí mít scope analytics.readonly (generate_refresh_token.py ho žádá sám).

# --- Sklik (docs/napojeni/sklik.md) ---
# API token účtu, přes který spravuješ klienty. Klientský účet se volí --user-id.
SKLIK_API_TOKEN=
# Volitelné: jiná adresa API (výchozí https://api.sklik.cz/drak/json)
# SKLIK_API_URL=
# Volitelné: druhý token pro účty pod jiným přístupem. Skriptu se předává jen NÁZEV:
#   SKLIK_TOKEN_VAR=SKLIK_DRUHY_TOKEN .venv/bin/python scripts/sklik/fetch.py --call client.get
# (v clients/hlidac-ucty.json pole "token_var": "SKLIK_DRUHY_TOKEN")
# SKLIK_DRUHY_TOKEN=

# --- Meta Ads (docs/napojeni/meta.md) ---
# Token systémového uživatele z Business Manageru. Na hlídače stačí oprávnění ads_read.
META_API_TOKEN=
# Volitelné: verze Graph API (výchozí ve skriptech v21.0)
# META_API_VERSION=

# --- ChatGPT Ads: NE SEM ---
# Appka chatgpt-ads/ čte klíč jen ze svého souboru chatgpt-ads/.env
# (založí ho chatgpt-ads/setup.sh ze vzoru chatgpt-ads/.env.example):
#   OPENAI_ADS_API_KEY=                 jeden účet
#   OPENAI_ADS_API_KEY_<NAZEV>=         víc účtů, volání s --account <nazev>
#   OPENAI_ADS_DEFAULT_ACCOUNT=         volitelně výchozí pojmenovaný účet
# Návod: docs/napojeni/chatgpt-ads.md

# --- AI bannery: NE SEM ---
# banner-generator/ čte klíče jen ze souboru banner-generator/.env.local
# (vzor banner-generator/.env.example):
#   GEMINI_API_KEY=                     výchozí generátor (Google AI Studio)
#   OPENAI_API_KEY=                     volitelně, generátor přes gpt-image-2
# Návod: docs/napojeni/bannery-ai.md

# --- Notifikace hlídačů ---
# Tokeny a webhooky pro e-mail / Slack / Telegram patří sem; názvy proměnných
# viz docs/notifikace.md.
